{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "qemx.selection.labels/2",
 "type": "object",
 "required": [
  "schema",
  "task_id",
  "base_id",
  "spec",
  "config_digest",
  "budgets",
  "protocols",
  "R",
  "status"
 ],
 "properties": {
  "schema": {
   "enum": [
    "qemx.selection.labels/1",
    "qemx.selection.labels/2"
   ]
  },
  "task_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{20}$"
  },
  "base_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{16}$"
  },
  "spec": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "qemx.task/1",
   "type": "object",
   "required": [
    "family",
    "n",
    "params",
    "inputs",
    "observable",
    "device",
    "layout",
    "opt_level",
    "seed",
    "truth"
   ],
   "properties": {
    "family": {
     "enum": [
      "qft",
      "ghz",
      "ising",
      "brickwork",
      "grover",
      "bv",
      "hea",
      "qaoa"
     ]
    },
    "n": {
     "type": "integer",
     "minimum": 2,
     "maximum": 12
    },
    "params": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
     }
    },
    "inputs": {
     "enum": [
      "default",
      "plus",
      "product"
     ]
    },
    "observable": {
     "enum": [
      "default",
      "z_mid",
      "zz_mid",
      "z_all"
     ]
    },
    "device": {
     "type": "string",
     "pattern": "^fake_[a-z0-9_]+(@[a-z][a-z0-9]{0,3}=[A-Za-z0-9.+\\-]{1,24}(,[a-z][a-z0-9]{0,3}=[A-Za-z0-9.+\\-]{1,24}){0,9})?$"
    },
    "layout": {
     "enum": [
      "best",
      "alt"
     ]
    },
    "opt_level": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "seed": {
     "type": "integer"
    },
    "truth": {
     "type": "string",
     "pattern": "^([a-z]{1,4}=[0-9.eE+\\-]+)?(,[a-z]{1,4}=[0-9.eE+\\-]+)*$"
    }
   },
   "additionalProperties": false
  },
  "config_digest": {
   "type": "string"
  },
  "budgets": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "protocols": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "R": {
   "type": "integer"
  },
  "status": {
   "enum": [
    "ok",
    "error",
    "timeout",
    "memory"
   ]
  },
  "ideal": {
   "type": "number"
  },
  "allocations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "protocol",
     "B",
     "feasible"
    ],
    "properties": {
     "protocol": {
      "type": "string"
     },
     "B": {
      "type": "integer"
     },
     "feasible": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     },
     "N": {
      "type": "integer"
     },
     "s": {
      "type": "integer"
     },
     "c": {
      "type": "integer"
     },
     "s_tr": {
      "type": "integer"
     },
     "split": {
      "type": "array"
     },
     "ledger": {
      "type": "object",
      "additionalProperties": {
       "type": "integer"
      }
     }
    }
   }
  },
  "features": {
   "type": "object"
  },
  "task": {
   "type": "object"
  }
 }
}
