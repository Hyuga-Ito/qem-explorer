{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "qemx.task/1",
 "type": "object",
 "required": [
  "family",
  "n",
  "params",
  "inputs",
  "observable",
  "device",
  "layout",
  "opt_level",
  "seed",
  "truth"
 ],
 "properties": {
  "family": {
   "enum": [
    "qft",
    "ghz",
    "ising",
    "brickwork",
    "grover",
    "bv",
    "hea",
    "qaoa"
   ]
  },
  "n": {
   "type": "integer",
   "minimum": 2,
   "maximum": 12
  },
  "params": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2
   }
  },
  "inputs": {
   "enum": [
    "default",
    "plus",
    "product"
   ]
  },
  "observable": {
   "enum": [
    "default",
    "z_mid",
    "zz_mid",
    "z_all"
   ]
  },
  "device": {
   "type": "string",
   "pattern": "^fake_[a-z0-9_]+(@[a-z][a-z0-9]{0,3}=[A-Za-z0-9.+\\-]{1,24}(,[a-z][a-z0-9]{0,3}=[A-Za-z0-9.+\\-]{1,24}){0,9})?$"
  },
  "layout": {
   "enum": [
    "best",
    "alt"
   ]
  },
  "opt_level": {
   "type": "integer",
   "minimum": 0,
   "maximum": 3
  },
  "seed": {
   "type": "integer"
  },
  "truth": {
   "type": "string",
   "pattern": "^([a-z]{1,4}=[0-9.eE+\\-]+)?(,[a-z]{1,4}=[0-9.eE+\\-]+)*$"
  }
 },
 "additionalProperties": false
}
