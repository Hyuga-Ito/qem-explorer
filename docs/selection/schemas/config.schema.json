{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "qemx.selection.config/1",
 "type": "object",
 "required": [
  "schema",
  "name",
  "master_seed",
  "R",
  "budgets",
  "protocols",
  "tasks"
 ],
 "properties": {
  "schema": {
   "const": "qemx.selection.config/1"
  },
  "name": {
   "type": "string"
  },
  "master_seed": {
   "type": "integer"
  },
  "R": {
   "type": "integer",
   "minimum": 2
  },
  "budgets": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 1
   },
   "minItems": 1
  },
  "protocols": {
   "type": "array",
   "items": {
    "enum": [
     "RAW",
     "RO",
     "ZNE-L",
     "ZNE-R",
     "ZNE-E",
     "PEC",
     "CDR",
     "NIL"
    ]
   },
   "minItems": 1
  },
  "final_test_fraction": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "truth": {
   "type": "string"
  },
  "tasks": {
   "type": "object",
   "required": [
    "widths",
    "families"
   ],
   "properties": {
    "widths": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "widths_by_family": {
     "type": "object"
    },
    "families": {
     "type": "object"
    },
    "inputs": {
     "type": "array",
     "items": {
      "enum": [
       "default",
       "plus",
       "product"
      ]
     }
    },
    "observables": {
     "type": "array",
     "items": {
      "enum": [
       "default",
       "z_mid",
       "zz_mid",
       "z_all"
      ]
     }
    },
    "layouts": {
     "type": "array",
     "items": {
      "enum": [
       "best",
       "alt"
      ]
     }
    },
    "devices": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "variants_per_base": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "limits": {
   "type": "object"
  },
  "analysis": {
   "type": "object"
  },
  "mismatch": {
   "type": "object"
  }
 }
}