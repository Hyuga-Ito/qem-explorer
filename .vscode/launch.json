{
  // Run and Debug (Ctrl+Shift+D / Cmd+Shift+D): pick a configuration, press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEM Explorer (Streamlit app)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py", "--server.port", "8501", "--client.showErrorDetails", "full"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" },
      "justMyCode": true
    },
    {
      "name": "Tests (fast)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "-m", "not slow", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" }
    },
    {
      "name": "Tests (all, incl. app and export)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" }
    },
    {
      "name": "Exported script: open file, Qiskit Aer",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": ["--aer"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" }
    },
    {
      "name": "Exported script: open file, exact NumPy",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "args": ["--numpy"],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" }
    }
  ]
}
