{
  // Terminal > Run Task… : the same actions without the debugger.
  "version": "2.0.0",
  // GLIBC_TUNABLES: Linux only (glibc), ignored elsewhere — scikit-learn and qiskit-aer load two OpenMP runtimes that
  // need more static TLS than glibc reserves by default (README, Linux note). Set here so tasks do not depend on the shell.
  "options": { "env": { "GLIBC_TUNABLES": "glibc.rtld.optional_static_tls=2048" } },
  "tasks": [
    {
      "label": "Install requirements",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements-dev.txt"],
      "problemMatcher": []
    },
    {
      "label": "Run QEM Explorer",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "streamlit", "run", "app.py", "--server.port", "8501", "--client.showErrorDetails", "full"],
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Tests (fast)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q", "-m", "not slow", "tests"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Tests (all)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q", "tests"],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
